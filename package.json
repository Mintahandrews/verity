{
  "name": "verity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-signal media authenticity engine: C2PA cryptographic provenance, metadata forensics, perceptual hashing, and fact-checking without labeling content 'fake'.",
  "license": "Apache-2.0",
  "author": "Andrews Mintah (https://github.com/mintahandrews)",
  "repository": {
    "type": "git",
    "url": "https://github.com/mintahandrews/verity.git"
  },
  "homepage": "https://github.com/mintahandrews/verity#readme",
  "bugs": {
    "url": "https://github.com/mintahandrews/verity/issues"
  },
  "keywords": [
    "c2pa",
    "content-credentials",
    "deepfake-detection",
    "media-authenticity",
    "provenance",
    "digital-forensics",
    "perceptual-hashing",
    "bk-tree",
    "misinformation-mitigation",
    "fact-checking",
    "chrome-extension",
    "manifest-v3",
    "synthetic-media",
    "ai-watermarking",
    "epistemic-security"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @verity/extension",
    "build": "npm run build -w @verity/extension",
    "registry": "npm run start -w @verity/registry",
    "bot": "npm run start -w @verity/bot",
    "sign": "npm run sign -w @verity/signer --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "icons": "node scripts/gen-icons.mjs",
    "anims": "node scripts/gen-anims.mjs",
    "banner": "node scripts/generate-banner.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "pack": "npm run build && mkdir -p release && cd packages/extension/dist && zip -qr ../../../release/verity-extension.zip . && echo \"packed release/verity-extension.zip\"",
    "start": "node scripts/start.mjs"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true,
    "sharp@0.34.5": true,
    "c2pa-node@0.5.26": true,
    "ffmpeg-static@5.3.0": true,
    "tesseract.js@7.0.0": true,
    "sharp@0.34.3": true
  },
  "engines": {
    "node": "24.x"
  }
}
