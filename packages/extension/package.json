{
  "name": "@checkverity/extension",
  "version": "0.1.0",
  "description": "Verity browser extension (Manifest V3) - client-side media authenticity inspector with C2PA and WASM sandbox",
  "author": "Andrews Mintah (https://github.com/mintahandrews)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mintahandrews/verity.git",
    "directory": "packages/extension"
  },
  "homepage": "https://github.com/mintahandrews/verity#readme",
  "bugs": {
    "url": "https://github.com/mintahandrews/verity/issues"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "c2pa",
    "content-credentials",
    "media-authenticity",
    "image-forensics",
    "reverse-search",
    "privacy-first"
  ],
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@contentauth/c2pa-types": "^0.7.4",
    "@contentauth/c2pa-web": "^0.15.1",
    "@fontsource/instrument-serif": "^5.3.0",
    "@checkverity/core": "*",
    "lottie-web": "^5.13.0",
    "onnxruntime-web": "^1.30.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
