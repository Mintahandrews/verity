    "start:discord": "node src/discord.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@checkverity/core": "*",
    "c2pa-node": "^0.5.26",
    "discord.js": "^14.27.0",
    "ffmpeg-static": "^5.3.0",
    "grammy": "^1.38.4",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
