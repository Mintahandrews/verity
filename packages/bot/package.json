{
  "name": "@checkverity/bot",
  "version": "0.1.0",
  "description": "High-throughput Telegram & Discord media verification bot for Verity",
  "author": "Andrews Mintah (https://github.com/Mintahandrews)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mintahandrews/verity.git",
    "directory": "packages/bot"
  },
  "homepage": "https://github.com/Mintahandrews/verity#readme",
  "bugs": {
    "url": "https://github.com/Mintahandrews/verity/issues"
  },
  "keywords": [
    "telegram-bot",
    "discord-bot",
    "media-verification",
    "fact-check",
    "c2pa",
    "image-forensics",
    "grammy",
    "sharp"
  ],
  "type": "module",
  "files": [
    "src",
    "assets"
  ],
  "publishConfig": {
